---
import { siteConfig } from "../config";

// 整屏壁纸：跟着横幅那张图走，换横幅 = 换壁纸
const images = import.meta.glob<string>("../assets/images/*.{png,jpg,jpeg,webp,avif}", {
	eager: true,
	query: "?url",
	import: "default",
});
const bgUrl =
	images[`../${siteConfig.banner.backdrop ?? siteConfig.banner.src}`] ??
	Object.values(images)[0];
---

<div id="void-backdrop" aria-hidden="true">
    <div class="void-backdrop-image" style={`background-image:url(${bgUrl})`}></div>
    <div class="void-backdrop-veil"></div>
</div>

<style is:global>
    /* 放在所有内容底下的一层「壁纸 + 压暗」，
       上面的卡片是半透明的，于是整页有了景深。 */
    #void-backdrop {
        position: fixed;
        inset: 0;
        z-index: -10;
        overflow: hidden;
        pointer-events: none;
    }
    #void-backdrop .void-backdrop-image {
        position: absolute;
        inset: -3rem;
        background-size: cover;
        background-position: center;
        filter: blur(30px) saturate(1.2) brightness(1.04);
        transform: scale(1.06);
        opacity: 0.35;
    }
    #void-backdrop .void-backdrop-veil {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            180deg,
            rgba(250, 250, 254, 0.7) 0%,
            rgba(249, 250, 254, 0.72) 45%,
            rgba(246, 247, 252, 0.78) 100%
        );
    }
    html.dark #void-backdrop .void-backdrop-image {
        filter: blur(30px) saturate(1.3) brightness(0.42);
        opacity: 1;
    }
    html.dark #void-backdrop .void-backdrop-veil {
        background: linear-gradient(
            180deg,
            rgba(9, 10, 15, 0.42) 0%,
            rgba(9, 10, 15, 0.55) 45%,
            rgba(8, 9, 14, 0.66) 100%
        );
    }
</style>
