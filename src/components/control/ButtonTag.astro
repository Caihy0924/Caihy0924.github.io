---
interface Props {
	size?: string;
	dot?: boolean;
	href?: string;
	label?: string;
}
const { dot, href, label }: Props = Astro.props;
---
<a href={href} aria-label={label}
   class="transition h-8 text-sm px-3 rounded-lg flex items-center
   text-[var(--tag-fg)] bg-[var(--tag-bg)] hover:brightness-125
   border border-[var(--card-border)]">
    {dot && <div class="h-1 w-1 bg-[var(--btn-content)] dark:bg-[var(--card-bg)] transition rounded-md mr-2"></div>}
    <slot></slot>
</a>
