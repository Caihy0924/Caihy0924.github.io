---
import type { MarkdownHeading } from "astro";
import Categories from "./Categories.astro";
import Profile from "./Profile.astro";
import SiteStats from "./SiteStats.astro";
import Tag from "./Tags.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
}

const className = Astro.props.class;
---
<div id="sidebar" class:list={[className, "w-full"]}>
    <div class="flex flex-col w-full gap-4">
        <Profile></Profile>
        <Categories class="onload-animation" style="animation-delay: 100ms"></Categories>
        <Tag class="onload-animation" style="animation-delay: 150ms"></Tag>
        <SiteStats class="onload-animation" style="animation-delay: 200ms"></SiteStats>
    </div>
</div>
