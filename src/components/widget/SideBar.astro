---
import type { MarkdownHeading } from "astro";
import { siteConfig } from "../../config";
import Calendar from "./Calendar.astro";
import Categories from "./Categories.astro";
import Profile from "./Profile.astro";
import RecentDynamic from "./RecentDynamic.astro";
import SiteStats from "./SiteStats.astro";
import Tag from "./Tags.astro";
import TOC from "./TOC.astro";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
}

const className = Astro.props.class;
const { headings = [] } = Astro.props;
const showToc = siteConfig.toc.enable && headings.length > 0;
---
<div id="sidebar" class:list={[className, "w-full"]}>
    <div class="flex flex-col w-full gap-4">
        <Profile></Profile>

        <!-- 注意：Swup 的容器之一就是 #toc，这个 div 必须每页都存在 -->
        <div id="toc">
            {showToc && (
                <WidgetLayout name="目录" id="toc-widget" class="onload-animation">
                    <div id="toc-inner-wrapper" class="pb-4 max-h-[50vh] overflow-y-auto overflow-x-hidden hide-scrollbar">
                        <TOC headings={headings}></TOC>
                    </div>
                </WidgetLayout>
            )}
        </div>

        <Categories class="onload-animation" style="animation-delay: 100ms"></Categories>
        <Tag class="onload-animation" style="animation-delay: 150ms"></Tag>
        <SiteStats class="onload-animation" style="animation-delay: 200ms"></SiteStats>
        <RecentDynamic class="onload-animation" style="animation-delay: 250ms"></RecentDynamic>
        <Calendar class="onload-animation" style="animation-delay: 300ms"></Calendar>
    </div>
</div>
