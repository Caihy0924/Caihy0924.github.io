---
import { analyticsConfig } from "../../config";
import { getSiteStats } from "../../utils/content-utils";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;

const stats = await getSiteStats();

const days = Math.max(
	1,
	Math.floor((Date.now() - stats.since.getTime()) / 86400000),
);

// 和 Fuwari 其它地方保持一致：Astro 存的是 UTC 时间，输出也按 UTC，免得差一天
const fmt = (d: Date) => d.toISOString().slice(0, 10);

const rows = [
	{ label: "文章", value: String(stats.posts) },
	{ label: "分类", value: String(stats.categories) },
	{ label: "标签", value: String(stats.tags) },
	{ label: "总字数", value: stats.words.toLocaleString("en-US") },
	{ label: "运行时长", value: `${days} 天` },
	{ label: "最近更新", value: fmt(stats.lastUpdate) },
];
---

<WidgetLayout name="站点统计" id="site-stats" class={className} style={style}>
    <div class="pb-4 flex flex-col gap-2.5">
        {rows.map((r) => (
            <div class="flex items-center justify-between text-sm">
                <span class="text-black/50 dark:text-white/50">{r.label}</span>
                <span class="font-bold tabular-nums">{r.value}</span>
            </div>
        ))}
        {analyticsConfig.visitorBadge.enable && (
            <div class="flex items-center justify-between text-sm">
                <span class="text-black/50 dark:text-white/50">总访问</span>
                <img
                    src={`https://visitor-badge.laobi.icu/badge?page_id=${encodeURIComponent(analyticsConfig.visitorBadge.pageId)}&left_text=${encodeURIComponent(analyticsConfig.visitorBadge.label)}`}
                    alt="访问量"
                    class="h-5"
                    loading="lazy"
                    referrerpolicy="no-referrer"
                    onerror="this.closest('div').style.display='none'"
                />
            </div>
        )}
    </div>
</WidgetLayout>
