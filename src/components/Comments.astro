---
import { commentConfig } from "../config";

const {
    enable,
    repo,
    repoId,
    category,
    categoryId,
    mapping,
    lang,
    darkTheme,
    lightTheme,
} = commentConfig;
const ready = enable && repoId !== "" && categoryId !== "";
---

{enable && (
    <div class="card-base px-6 md:px-9 py-6 mb-4 onload-animation">
        <div class="text-xl font-bold mb-4">评论</div>

        {ready && <div class="giscus"></div>}

        {!ready && (
            <div class="text-sm text-black/40 dark:text-white/40 leading-relaxed">
                评论还没接通。需要在 GitHub 仓库设置里打开 Discussions，
                再去 <a class="text-[var(--primary)]" href="https://giscus.app/zh-CN" target="_blank" rel="noopener">giscus.app</a>
                生成 repoId 和 categoryId，填到 <code>src/config.ts</code> 的 commentConfig 里。
            </div>
        )}
    </div>
)}

{ready && (
    <script is:inline
        src="https://giscus.app/client.js"
        data-repo={repo}
        data-repo-id={repoId}
        data-category={category}
        data-category-id={categoryId}
        data-mapping={mapping}
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme={darkTheme}
        data-lang={lang}
        data-loading="lazy"
        crossorigin="anonymous"
        async>
    </script>
)}

{ready && (
    <script is:inline define:vars={{ darkTheme, lightTheme }}>
        /* 让评论框的配色跟着站点主题走（默认是暗色，切到亮色时同步过去）。
           giscus 自带的 preferred_color_scheme 跟的是操作系统偏好，
           和站点自己的明暗开关是两回事，容易撞色。 */
        (function () {
            const host = document.querySelector(".giscus");
            if (!host) return;

            function applyTheme() {
                const frame = host.querySelector("iframe.giscus-frame");
                if (!frame || !frame.contentWindow) return;
                const isDark = document.documentElement.classList.contains("dark");
                frame.contentWindow.postMessage(
                    { giscus: { setConfig: { theme: isDark ? darkTheme : lightTheme } } },
                    "https://giscus.app"
                );
            }

            // 评论框是懒加载的，等它插进 DOM 再同步
            new MutationObserver(applyTheme).observe(host, { childList: true, subtree: true });
            // 用户切换明暗主题时同步
            new MutationObserver(applyTheme).observe(document.documentElement, {
                attributes: true,
                attributeFilter: ["class"],
            });
        })();
    </script>
)}
