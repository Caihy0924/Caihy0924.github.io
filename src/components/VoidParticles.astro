---
// 虚空粒子：仿《空洞骑士》那种在黑暗里缓缓上浮的白色微粒。
// 纯 canvas，不依赖任何外部图片；跟随明暗主题换色；尊重系统「减少动态效果」设置。
---

<canvas id="void-particles" aria-hidden="true"></canvas>

<style>
    #void-particles {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        /* 盖在横幅之上、内容卡片之下，这样粒子会飘在壁纸和页面底色上，但不会糊在正文上 */
        z-index: 20;
    }

    @media (prefers-reduced-motion: reduce) {
        #void-particles {
            opacity: 0.5;
        }
    }
</style>

<script>
	(function () {
		const canvas = document.getElementById("void-particles");
		if (!(canvas instanceof HTMLCanvasElement)) return;
		const ctx = canvas.getContext("2d");
		if (!ctx) return;

		/* 预渲染两张光点贴图：深色主题用冷白，浅色主题用灰蓝，
		   比每个粒子现画径向渐变快一个数量级。 */
		function makeSprite(inner: string, mid: string) {
			const c = document.createElement("canvas");
			c.width = 64;
			c.height = 64;
			const g = c.getContext("2d");
			if (g) {
				const grad = g.createRadialGradient(32, 32, 0, 32, 32, 32);
				grad.addColorStop(0, inner);
				grad.addColorStop(0.35, mid);
				grad.addColorStop(1, "rgba(0,0,0,0)");
				g.fillStyle = grad;
				g.fillRect(0, 0, 64, 64);
			}
			return c;
		}

		const spriteForDark = makeSprite("rgba(255,255,255,1)", "rgba(214,238,255,0.55)");
		const spriteForLight = makeSprite("rgba(70,96,124,0.9)", "rgba(110,140,170,0.35)");

		type Particle = {
			x: number;
			y: number;
			radius: number;
			speed: number;
			drift: number;
			phase: number;
			alpha: number;
		};

		let width = 0;
		let height = 0;
		let particles: Particle[] = [];
		let rafId = 0;
		let running = false;
		let clock = 0;
		let resizeTimer = 0;

		const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

		function spawn(p: Particle, scattered: boolean) {
			p.x = Math.random() * width;
			p.y = scattered ? Math.random() * height : height + 40 + Math.random() * 80;
			p.radius = 0.7 + Math.random() * 2.1;
			p.speed = 0.08 + Math.random() * 0.42;
			p.drift = 0.15 + Math.random() * 0.5;
			p.phase = Math.random() * Math.PI * 2;
			p.alpha = 0.18 + Math.random() * 0.55;
			return p;
		}

		function rebuild() {
			const target = Math.max(26, Math.min(90, Math.round((width * height) / 24000)));
			particles = [];
			for (let i = 0; i < target; i++) {
				particles.push(spawn({} as Particle, true));
			}
		}

		function draw() {
			ctx.clearRect(0, 0, width, height);

			const dark = document.documentElement.classList.contains("dark");
			const sprite = dark ? spriteForDark : spriteForLight;
			// 深色底上用叠加发光，浅色底上正常绘制，免得太刺眼
			ctx.globalCompositeOperation = dark ? "lighter" : "source-over";

			for (const p of particles) {
				p.y -= p.speed;
				if (p.y < -30) {
					spawn(p, false);
					continue;
				}

				const x = p.x + Math.sin(clock * p.drift + p.phase) * 14;
				const twinkle = 0.75 + 0.25 * Math.sin(clock * 1.6 + p.phase);
				const size = p.radius * 6;

				ctx.globalAlpha = dark ? p.alpha * twinkle : p.alpha * twinkle * 0.5;
				ctx.drawImage(sprite, x - size / 2, p.y - size / 2, size, size);
			}

			ctx.globalAlpha = 1;
			ctx.globalCompositeOperation = "source-over";
		}

		function frame() {
			if (!running) return;
			clock += 0.01;
			draw();
			rafId = window.requestAnimationFrame(frame);
		}

		function start() {
			if (running || motionQuery.matches) return;
			running = true;
			rafId = window.requestAnimationFrame(frame);
		}

		function stop() {
			running = false;
			window.cancelAnimationFrame(rafId);
		}

		function resize() {
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			width = window.innerWidth;
			height = window.innerHeight;
			canvas.width = Math.floor(width * dpr);
			canvas.height = Math.floor(height * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			rebuild();
			draw();
		}

		resize();

		window.addEventListener("resize", () => {
			window.clearTimeout(resizeTimer);
			resizeTimer = window.setTimeout(resize, 180);
		});

		// 标签页看不见就别烧 CPU
		document.addEventListener("visibilitychange", () => {
			if (document.hidden) stop();
			else start();
		});

		motionQuery.addEventListener("change", () => {
			if (motionQuery.matches) {
				stop();
				draw();
			} else {
				start();
			}
		});

		// 主题切换后重画一帧，让粒子换个颜色
		const themeWatcher = new MutationObserver(draw);
		themeWatcher.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["class"],
		});

		if (motionQuery.matches) {
			draw(); // 静态一帧，不跑动画
		} else {
			start();
		}
	})();
</script>
