---
// 横幅上的文字层：大标题 + 打字机副标题 + 社交图标
// 只在首页显示（靠 body 上的 lg:is-home 类判断，Swup 切换页面时会自动跟着变）
import { Icon } from "astro-icon/components";
import { bannerTextConfig, profileConfig } from "../config";
import { url } from "../utils/url-utils";

const { enable, title, subtitles, typewriter, showSocial } = bannerTextConfig;
const lines = (subtitles ?? []).filter((s) => s && s.trim() !== "");
const socials = showSocial ? profileConfig.links : [];
---

{enable && (
    <div id="banner-hero">
        <div class="banner-hero-shade"></div>
        <div class="banner-hero-inner">
            {title && <h1 class="banner-hero-title">{title}</h1>}
            {lines.length > 0 && (
                <p class="banner-hero-sub">
                    <span id="banner-hero-typed">{typewriter ? "" : lines[0]}</span><span class="banner-hero-cursor">|</span>
                </p>
            )}
            {(socials.length > 0 || showSocial) && (
                <div class="banner-hero-social">
                    {socials.map((item) => (
                        <a href={item.url} target="_blank" rel="me" aria-label={item.name} class="banner-hero-btn">
                            <Icon name={item.icon} />
                        </a>
                    ))}
                    <a href={url("/rss.xml")} aria-label="RSS" class="banner-hero-btn">
                        <Icon name="material-symbols:rss-feed-rounded" />
                    </a>
                </div>
            )}
        </div>
        <div class="banner-hero-scroll" aria-hidden="true">
            <Icon name="material-symbols:keyboard-double-arrow-down-rounded" />
        </div>
    </div>
)}

<script define:vars={{ lines, typewriter }}>
	(function () {
		const typedEl = document.getElementById("banner-hero-typed");
		if (!typedEl || !lines || lines.length === 0) return;

		const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		if (!typewriter || reduceMotion) {
			typedEl.textContent = lines[0];
			return;
		}

		let lineIndex = 0;
		let charIndex = 0;
		let deleting = false;

		const TYPE_SPEED = 95;
		const DELETE_SPEED = 38;

		function tick() {
			const full = lines[lineIndex] || "";

			if (!deleting) {
				charIndex++;
				typedEl.textContent = full.slice(0, charIndex);
				if (charIndex >= full.length) {
					// 只有一句就停在这，多句才继续轮播
					if (lines.length === 1) return;
					deleting = true;
					window.setTimeout(tick, 2400);
					return;
				}
				window.setTimeout(tick, TYPE_SPEED);
				return;
			}

			charIndex--;
			typedEl.textContent = full.slice(0, charIndex);
			if (charIndex <= 0) {
				deleting = false;
				lineIndex = (lineIndex + 1) % lines.length;
				window.setTimeout(tick, 420);
				return;
			}
			window.setTimeout(tick, DELETE_SPEED);
		}

		window.setTimeout(tick, 600);
	})();
</script>

<style>
    #banner-hero {
        position: absolute;
        inset: 0;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 0 1.5rem;
        pointer-events: none;
    }

    /* 不在首页就整个藏起来（body 上的 lg:is-home 由 Layout 的 Swup 钩子维护） */
    :global(body:not(.lg:is-home)) #banner-hero {
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s ease;
    }

    .banner-hero-shade {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to bottom,
            rgba(0, 0, 0, 0.1) 0%,
            rgba(0, 0, 0, 0.28) 45%,
            rgba(0, 0, 0, 0.55) 100%
        );
    }

    .banner-hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        max-width: 52rem;
    }

    .banner-hero-title {
        margin: 0;
        font-size: clamp(2.2rem, 5.4vw, 4.5rem);
        font-weight: 800;
        line-height: 1.12;
        letter-spacing: 0.01em;
        color: #fff;
        text-shadow: 0 2px 24px rgba(0, 0, 0, 0.75), 0 1px 4px rgba(0, 0, 0, 0.6);
    }

    .banner-hero-sub {
        margin: 0;
        min-height: 1.6em;
        font-size: clamp(0.9rem, 1.7vw, 1.25rem);
        color: rgba(255, 255, 255, 0.9);
        text-shadow: 0 1px 12px rgba(0, 0, 0, 0.85);
    }

    .banner-hero-cursor {
        margin-left: 2px;
        animation: bannerHeroBlink 1.1s steps(2, start) infinite;
    }

    @keyframes bannerHeroBlink {
        to {
            opacity: 0;
        }
    }

    .banner-hero-social {
        display: flex;
        gap: 0.6rem;
        margin-top: 0.4rem;
        pointer-events: auto;
    }

    .banner-hero-btn {
        width: 2.9rem;
        height: 2.9rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9999px;
        font-size: 1.45rem;
        color: rgba(255, 255, 255, 0.92);
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.22);
        backdrop-filter: blur(10px);
        transition: background 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
    }

    .banner-hero-btn:hover {
        background: rgba(255, 255, 255, 0.26);
        border-color: rgba(255, 255, 255, 0.45);
        transform: translateY(-2px);
    }

    /* 首屏底部那个「往下滑」的小提示 */
    .banner-hero-scroll {
        position: absolute;
        left: 50%;
        bottom: 4.5rem;
        transform: translateX(-50%);
        color: rgba(255, 255, 255, 0.7);
        font-size: 2rem;
        animation: bannerHeroFloat 2.2s ease-in-out infinite;
    }

    @keyframes bannerHeroFloat {
        0%, 100% { transform: translate(-50%, 0); opacity: 0.55; }
        50% { transform: translate(-50%, 6px); opacity: 0.95; }
    }

    @media (prefers-reduced-motion: reduce) {
        .banner-hero-cursor,
        .banner-hero-scroll {
            animation: none;
        }
    }
</style>
