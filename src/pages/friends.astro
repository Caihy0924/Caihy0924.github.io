---
import { Icon } from "astro-icon/components";
import { friendsConfig } from "../config";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const friends = friendsConfig.friends;
---

<MainGridLayout title="友链">
    <div class="card-base px-6 md:px-9 py-6 mb-4 onload-animation">
        <div class="flex items-center gap-3 mb-6">
            <Icon name="material-symbols:link-rounded" class="text-[var(--primary)] text-[1.75rem]" />
            <h1 class="text-2xl font-bold">友链</h1>
        </div>

        {friends.length === 0 && (
            <p class="text-sm text-black/40 dark:text-white/40">
                还没有友链，去 src/config.ts 的 friendsConfig 里加。
            </p>
        )}

        <div class="grid gap-4 sm:grid-cols-2">
            {friends.map((f) => (
                <a href={f.url} target="_blank" rel="noopener"
                   class="btn-card rounded-2xl p-4 flex items-center gap-3 overflow-hidden active:scale-95">
                    <img src={f.avatar} alt={f.name} width="44" height="44" loading="lazy"
                         class="w-11 h-11 rounded-full object-cover shrink-0" />
                    <div class="min-w-0">
                        <div class="font-bold truncate">{f.name}</div>
                        <div class="text-sm text-75 truncate">{f.description}</div>
                    </div>
                </a>
            ))}
        </div>
    </div>
</MainGridLayout>
